{
  "buildCommand": "cd Generative/frontend && npm install && DISABLE_ESLINT_PLUGIN=true CI=false npm run build && cp -r build/* ../../",
  "outputDirectory": ".",
  "installCommand": "npm install --prefix Generative/frontend",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|gif|svg|json|txt|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}